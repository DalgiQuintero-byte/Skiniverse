@model IEnumerable<Skiniverse.Models.Producto>

@{
    ViewData["Title"] = "Catálogo de Skincare";
}

<div class="row mb-4">
    <div class="col-12 text-center">
        <h2 class="fw-bold" style="color: var(--skin-primary);">Descubre Tu Rutina Ideal</h2>
        <p class="text-muted">Productos formulados con ingredientes activos para transformar tu piel.</p>
    </div>
</div>

<div class="row row-cols-1 row-cols-md-3 g-4">
    @foreach (var item in Model)
    {
        <div class="col">
            <div class="card card-skin h-100 p-3">
                <div class="text-center p-3">
                    <img src="@item.ImagenUrl" alt="@item.NombreProducto" class="img-fluid rounded" style="max-height: 180px; object-fit: contain;" />
                </div>
                <div class="card-body d-flex flex-column">
                    <span class="badge bg-light text-secondary border mb-2 align-self-start">@item.Categoria</span>
                    <h5 class="card-title fw-bold text-dark">@item.NombreProducto</h5>
                    <p class="small text-muted mb-1"><strong>Para:</strong> @item.TipoPielRecomendado</p>
                    <p class="small text-muted mb-3"><strong>Activos:</strong> @item.IngredientesActivos</p>

                    <div class="mt-auto d-flex justify-content-between align-items-center">
                        <span class="fs-5 fw-bold" style="color: var(--skin-primary);">$@item.PrecioRegular.ToString("N0")</span>
                        <button class="btn btn-outline-secondary btn-sm rounded-2">
                            <i class="bi bi-eye me-1"></i> Ver Detalles
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
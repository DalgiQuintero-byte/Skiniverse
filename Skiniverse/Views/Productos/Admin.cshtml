@model IEnumerable<Skiniverse.Models.Producto>

@{
    ViewData["Title"] = "Panel de Administración - Productos";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold" style="color: var(--skin-primary);">Gestión de Productos</h2>
        <p class="text-muted mb-0">Panel de administración de catálogo Skiniverse</p>
    </div>
    <!-- BOTÓN DE AGREGAR MOVIDO A LA VISTA ADMIN -->
    <a asp-controller="Productos" asp-action="Crear" class="btn text-white fw-semibold" style="background-color: #0F4C81; border-radius: 8px;">
        <i class="bi bi-plus-lg me-1"></i> Agregar Nuevo Producto
    </a>
</div>

<div class="card shadow-sm border-0 rounded-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Imagen</th>
                        <th>Producto</th>
                        <th>Categoría</th>
                        <th>Precio</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <img src="@item.ImagenUrl" alt="@item.NombreProducto" style="width: 45px; height: 45px; object-fit: contain;" class="rounded" />
                            </td>
                            <td class="fw-bold">@item.NombreProducto</td>
                            <td><span class="badge bg-light text-dark border">@item.Categoria</span></td>
                            <td class="fw-bold" style="color: var(--skin-primary);">$@item.PrecioRegular.ToString("N0")</td>
                            <td class="text-end">
                                <a asp-action="Editar" asp-route-id="@item.IdProducto" class="btn btn-sm btn-outline-primary me-1">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-action="Eliminar" asp-route-id="@item.IdProducto" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
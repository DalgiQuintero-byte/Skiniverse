@model Skiniverse.Models.Producto

@{
    ViewData["Title"] = "Agregar Nuevo Producto";
}

<div class="container my-4 style="max-width: 600px;">
    <h2 class="mb-4 text-primary fw-bold">Registrar Nuevo Producto</h2>

    <form asp-action="Crear" method="post" class="card p-4 shadow-sm border-0 bg-white">
        <div class="mb-3">
            <label class="form-label fw-bold">Nombre del Producto</label>
            <input asp-for="NombreProducto" class="form-control" required placeholder="Ej. Sérum Hidratante" />
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label fw-bold">Categoría</label>
                <input asp-for="Categoria" class="form-control" required placeholder="Ej. Sérum, Limpiador" />
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label fw-bold">Tipo de Piel</label>
                <input asp-for="TipoPielRecomendado" class="form-control" required placeholder="Ej. Mixta, Sensible" />
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Ingredientes Activos</label>
            <input asp-for="IngredientesActivos" class="form-control" required placeholder="Ej. Ácido Hialurónico" />
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label fw-bold">Precio Regular ($)</label>
                <input asp-for="PrecioRegular" type="number" step="0.01" class="form-control" required />
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label fw-bold">Stock Actual</label>
                <input asp-for="StockActual" type="number" class="form-control" required />
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">URL de la Imagen</label>
            <input asp-for="ImagenUrl" class="form-control" placeholder="https://..." />
        </div>

        <div class="d-flex justify-content-end gap-2 mt-3">
            <a asp-action="Catalogo" class="btn btn-outline-secondary">Cancelar</a>
            <button type="submit" class="btn btn-success"><i class="bi bi-check-lg"></i> Guardar Producto</button>
        </div>
    </form>
</div>
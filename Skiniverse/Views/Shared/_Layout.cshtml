@using Microsoft.AspNetCore.Http
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Skiniverse</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />

    <style>
        :root {
            --skin-primary: #1B3C73;
            --skin-secondary: #028090;
            --skin-accent: #2EC4B6;
            --skin-ice: #EBF4F6;
            --skin-light: #F8FBFC;
            --skin-dark: #0D1B2A;
        }

        body {
            background-color: var(--skin-ice);
            color: var(--skin-dark);
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        }

        .navbar-skiniverse {
            background: linear-gradient(135deg, var(--skin-primary), var(--skin-secondary));
            box-shadow: 0 4px 20px rgba(27, 60, 115, 0.15);
        }

        .brand-logo {
            background-color: #ffffff;
            color: var(--skin-primary);
            font-weight: 800;
            padding: 6px 14px;
            border-radius: 12px;
        }

        .card-skin {
            background: var(--skin-light);
            border: 1px solid rgba(2, 128, 144, 0.1);
            border-radius: 20px;
            transition: all 0.3s ease;
        }

            .card-skin:hover {
                transform: translateY(-50px);
                box-shadow: 0 12px 30px rgba(2, 128, 144, 0.12);
            }

        .btn-skin-primary {
            background-color: var(--skin-secondary);
            color: white;
            border: none;
            border-radius: 12px;
            font-weight: 600;
            padding: 10px 20px;
            transition: background 0.2s;
        }

            .btn-skin-primary:hover {
                background-color: var(--skin-primary);
                color: white;
            }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-skiniverse py-3">
            <div class="container px-4">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <span class="brand-logo"><i class="bi bi-droplet-fill me-1" style="color: var(--skin-secondary);"></i>Skiniverse</span>
                </a>
                <div class="d-flex align-items-center gap-3">
                    <a asp-controller="Home" asp-action="Index" class="text-white text-decoration-none fw-semibold">Inicio</a>
                    <a asp-controller="Home" asp-action="Privacy" class="text-white text-decoration-none fw-semibold">Privacidad</a>
                </div>
            </div>
        </nav>
    </header>

    <div class="container my-5">
        @RenderBody()
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
@using Microsoft.AspNetCore.Http
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Skiniverse</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />

    <style>
        :root {
            --skin-primary: #1B3C73;
            --skin-secondary: #028090;
            --skin-accent: #2EC4B6;
            --skin-ice: #EBF4F6;
            --skin-light: #F8FBFC;
            --skin-dark: #0D1B2A;
        }

        body {
            background-color: var(--skin-ice);
            color: var(--skin-dark);
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        }

        .navbar-skiniverse {
            background: linear-gradient(135deg, var(--skin-primary), var(--skin-secondary));
            box-shadow: 0 4px 20px rgba(27, 60, 115, 0.15);
        }

        .brand-logo {
            background-color: #ffffff;
            color: var(--skin-primary);
            font-weight: 800;
            padding: 6px 14px;
            border-radius: 12px;
        }

        .card-skin {
            background: var(--skin-light);
            border: 1px solid rgba(2, 128, 144, 0.1);
            border-radius: 20px;
            transition: all 0.3s ease;
        }

            .card-skin:hover {
                transform: translateY(-5px);
                box-shadow: 0 12px 30px rgba(2, 128, 144, 0.12);
            }

        .btn-skin-primary {
            background-color: var(--skin-secondary);
            color: white;
            border: none;
            border-radius: 12px;
            font-weight: 600;
            padding: 10px 20px;
            transition: background 0.2s;
        }

            .btn-skin-primary:hover {
                background-color: var(--skin-primary);
                color: white;
            }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-skiniverse py-3">
            <div class="container px-4">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <span class="brand-logo"><i class="bi bi-droplet-fill me-1" style="color: var(--skin-secondary);"></i>Skiniverse</span>
                </a>
                <div class="d-flex align-items-center gap-3">
                    <a asp-controller="Home" asp-action="Index" class="text-white text-decoration-none fw-semibold">Inicio</a>
                    <a asp-controller="Productos" asp-action="Catalogo" class="text-white text-decoration-none fw-semibold">Catálogo</a>
                    <a asp-controller="Home" asp-action="Privacy" class="text-white text-decoration-none fw-semibold">Privacidad</a>

                    <!-- Botón del Carrito -->
                    <button class="btn btn-outline-light position-relative ms-2" type="button" data-bs-toggle="offcanvas" data-bs-target="#carritoDrawer">
                        <i class="bi bi-cart3 fs-5"></i>
                        <span id="cart-count" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">0</span>
                    </button>
                </div>
            </div>
        </nav>
    </header>

    <div class="container my-5">
        @RenderBody()
    </div>

    <!-- Panel Lateral Desplegable (Carrito Offcanvas) -->
    <div class="offcanvas offcanvas-end" tabindex="-1" id="carritoDrawer" aria-labelledby="carritoDrawerLabel">
        <div class="offcanvas-header text-white" style="background-color: var(--skin-primary);">
            <h5 id="carritoDrawerLabel" class="mb-0 fw-bold"><i class="bi bi-cart-check me-2"></i>Tu Carrito</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body d-flex flex-column">
            <ul id="lista-carrito" class="list-group list-group-flush mb-auto"></ul>

            <div class="border-top pt-3 mt-3">
                <div class="d-flex justify-content-between font-weight-bold mb-3">
                    <span class="fw-bold fs-5">Total:</span>
                    <span id="total-carrito" class="fw-bold fs-5" style="color: var(--skin-secondary);">$0</span>
                </div>
                <button class="btn btn-skin-primary w-100 py-2" onclick="procederPago()">Proceder al Pago</button>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- Lógica JavaScript del Carrito -->
    <script>
        let carrito = JSON.parse(localStorage.getItem('carrito')) || [];

        function agregarAlCarrito(id, nombre, precio) {
            const existe = carrito.find(p => p.id === id);
            if (existe) {
                existe.cantidad++;
            } else {
                carrito.push({ id, nombre, precio, cantidad: 1 });
            }
            guardarYActualizar();
            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: 'success',
                title: 'Producto añadido',
                showConfirmButton: false,
                timer: 1500
            });
        }

        function guardarYActualizar() {
            localStorage.setItem('carrito', JSON.stringify(carrito));
            renderizarCarrito();
        }

        function renderizarCarrito() {
            const lista = document.getElementById('lista-carrito');
            const totalEl = document.getElementById('total-carrito');
            const countEl = document.getElementById('cart-count');

            if (!lista) return;

            lista.innerHTML = '';
            let total = 0;
            let itemsTotales = 0;

            if (carrito.length === 0) {
                lista.innerHTML = '<li class="text-center text-muted my-4">El carrito está vacío.</li>';
            } else {
                carrito.forEach(prod => {
                    total += prod.precio * prod.cantidad;
                    itemsTotales += prod.cantidad;
                    lista.innerHTML += `
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <div>
                                <h6 class="my-0 font-weight-bold">${prod.nombre}</h6>
                                <small class="text-muted">$${prod.precio.toLocaleString('es-CO')} x ${prod.cantidad}</small>
                            </div>
                            <div>
                                <span class="fw-bold me-2">$${(prod.precio * prod.cantidad).toLocaleString('es-CO')}</span>
                                <button class="btn btn-sm btn-outline-danger border-0" onclick="eliminarDelCarrito(${prod.id})">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </li>
                    `;
                });
            }

            totalEl.innerText = `$${total.toLocaleString('es-CO')}`;
            countEl.innerText = itemsTotales;
        }

        function eliminarDelCarrito(id) {
            carrito = carrito.filter(p => p.id !== id);
            guardarYActualizar();
        }

        function procederPago() {
            if (carrito.length === 0) {
                Swal.fire('Carrito Vacío', 'Agrega algún producto antes de pagar.', 'warning');
                return;
            }
            Swal.fire('¡Gracias por tu compra!', 'Serás redirigido a la pasarela de pago.', 'success');
        }

        document.addEventListener('DOMContentLoaded', renderizarCarrito);
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>